{
  "name": "@amiticia/baileys-client",
  "version": "0.3.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check .",
    "format": "biome check --write .",
    "dispatch": "bash scripts/dispatch-worktree.sh",
    "dispatch:cleanup": "bash scripts/cleanup-worktrees.sh",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "test:harness": "node --test \"scripts/*.test.mjs\" \"scripts/lib/*.test.mjs\""
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "p-retry": "^8.0.0",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^25.6.0",
    "husky": "^9.1.7",
    "tsup": "^8.4.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@whiskeysockets/baileys",
      "esbuild",
      "protobufjs",
      "sharp"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmiticIA-AutoSys/baileys-client.git"
  },
  "author": "AmiticIA-AutoSys",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2"
}
